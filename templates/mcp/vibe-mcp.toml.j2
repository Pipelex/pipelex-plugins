
# The Pipelex workshop, the MCP server the plugin's skills call, for {{ harness_name }}.
#
# {{ harness_name }} starts an MCP server a plugin declares in the plugin's own
# directory, and the workshop reads and writes files only inside the directory
# it starts in, so the plugin cannot declare it: it is this one entry in your
# configuration instead, which {{ harness_name }} starts in your project. Append it
# to the end of ~/.vibe/config.toml, or of $VIBE_HOME/config.toml when VIBE_HOME
# is set, which {{ harness_name }} merges with a trusted project's .vibe/config.toml,
# server by server, so the entry reaches every project:
#
#   cat <this file> >> "${VIBE_HOME:-$HOME/.vibe}/config.toml"
#
# Two things in that file stop {{ harness_name }} from starting once this is
# appended. An inline `mcp_servers = [...]` line, which TOML cannot extend with
# a table: delete the `mcp_servers = []` line a new configuration holds, or
# rewrite a list of servers as [[mcp_servers]] tables. And a `pipelex` server
# already there, such as the entry earlier instructions had you add: delete it,
# since {{ harness_name }} refuses two servers of the same name.
#
# The entry holds no key. The workshop reads the one that
# `npx -y @pipelex/mcp@latest login` saves in ~/.pipelex/.env, which it finds
# because {{ harness_name }} passes it HOME, though no other variable of your shell.
# To hand the server a variable, such as HTTPS_PROXY behind a proxy, or
# PIPELEX_HOME when you set it and the login saved the key there, add an
# [mcp_servers.env] table right below the entry.
#
# startup_timeout_sec is raised above {{ harness_name }}'s 10-second default because
# the first npx spawn fills the npm cache and takes longer than that.

[[mcp_servers]]
name = "pipelex"
transport = "stdio"
command = {{ [mcp_server.command] | tojson }}
args = {{ mcp_server.args | tojson }}
startup_timeout_sec = 60.0
