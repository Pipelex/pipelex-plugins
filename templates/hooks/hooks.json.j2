{#- How long Claude Code lets the hook run before it kills it, in seconds. check-mthds.mjs.j2 imports
    this value to stop the bundle a little earlier, so one number sets both (docs/hooks.md, "Timeout"). -#}
{%- set timeout_seconds = 15 -%}
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.mthds)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-mthds.mjs"],
            "timeout": {{ timeout_seconds }}
          },
          {
            "type": "command",
            "if": "Write(*.mthds)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-mthds.mjs"],
            "timeout": {{ timeout_seconds }}
          }
        ]
      }
    ]
  }
}
